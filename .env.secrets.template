# 🔐 SECRET AGENT ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your REAL API KEYS
# NEVER commit .env to git (it's in .gitignore for security)
#
# Quick setup:
#   1. cp .env.secrets.template .env
#   2. Add your real API keys below (from provider consoles)
#   3. source <(bash free-mode/scripts/activate-secret-agent.sh)
#   4. Done! All providers configured and ready

# =============================================================================
# FREE MODE CORE - Intelligent Provider Routing
# =============================================================================
# FREE MODE automatically routes to the cheapest/fastest provider:
# 1. Local models (Ollama, LM Studio) - FREE
# 2. Free cloud tiers (Groq, Gemini) - FREE
# 3. Paid providers (OpenAI, Anthropic) - Fallback

FREE_MODE=true
FREE_MODE_PROVIDER=auto                           # auto = smart routing
FREE_MODE_MODEL=free-auto                         # auto = best available
FREE_MODE_PROXY_BASE_URL=http://127.0.0.1:4000   # LiteLLM proxy URL
FREE_MODE_PROXY_MASTER_KEY=hermes-free-mode-key-2024
ANTHROPIC_BASE_URL=http://127.0.0.1:4000         # Route Claude through proxy
LITELLM_MASTER_KEY=hermes-free-mode-master-key   # Proxy auth key

# =============================================================================
# 🟢 FREE TIER PROVIDERS (Recommended - Start Here!)
# =============================================================================

# GROQ - ⚡ Fastest (40 requests/minute free)
# Get key: https://console.groq.com/keys
# Cost: FREE tier (40 req/min) - Perfect for development
GROQ_API_KEY=gsk-YOUR-KEY-HERE

# GOOGLE GEMINI - 🚀 Generous (60 requests/minute free)
# Get key: https://aistudio.google.com/app/apikey
# Cost: FREE tier (60 req/min)
GOOGLE_API_KEY=YOUR-GEMINI-KEY-HERE
GEMINI_API_KEY=YOUR-GEMINI-KEY-HERE

# NVIDIA NIM - 🎓 Enterprise Free Tier
# Get key: https://build.nvidia.com
# Cost: COMPLETELY FREE for developers
NVIDIA_NIM_API_KEY=nvapi-YOUR-KEY-HERE

# OPENROUTER - 📚 100+ Models (Free trial)
# Get key: https://openrouter.ai/keys
# Cost: Free 5 req/day, then $3-15 per million tokens
# Includes: Claude, GPT-4, Llama, Mistral, 100+ models
OPENROUTER_API_KEY=sk-or-v1-YOUR-KEY-HERE

# =============================================================================
# 🟡 PAID PROVIDERS (Add as needed - Fallback options)
# =============================================================================

# OpenAI (GPT-4, GPT-3.5-turbo)
# Get at: https://platform.openai.com/api-keys
# Cost: $0.03 input / $0.06 output per 1K tokens
OPENAI_API_KEY=sk-YOUR-KEY-HERE

# Anthropic (Claude - also available via OpenRouter cheaper)
# Get at: https://console.anthropic.com
# Cost: $3 input / $15 output per million tokens
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY-HERE

# Mistral AI (Mistral-7B, Mixtral, etc.)
# Get at: https://console.mistral.ai/api-keys
# Cost: $0.14-0.81 per million tokens (model dependent)
MISTRAL_API_KEY=YOUR-KEY-HERE
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Together AI (Open models + fast inference)
# Get at: https://www.together.ai/api
# Cost: Free tier available, then pay-as-you-go
TOGETHER_API_KEY=YOUR-KEY-HERE

# Perplexity AI (Search + AI)
# Get at: https://www.perplexity.ai
# Cost: Pay-as-you-go
PERPLEXITY_API_KEY=YOUR-KEY-HERE

# =============================================================================
# 🟣 LOCAL MODELS (FREE - Run on your machine)
# =============================================================================

# Ollama - Run open models locally (llama2, mistral, neural-chat, etc.)
# Download: https://ollama.ai
# Run: ollama serve (in another terminal)
# Cost: COMPLETELY FREE (runs on your computer)
OLLAMA_API_KEY=dummy
OLLAMA_BASE_URL=http://localhost:11434/v1

# LM Studio - Another local model runner
# Download: https://lmstudio.ai
# Cost: COMPLETELY FREE (runs on your computer)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# =============================================================================
# OPTIONAL: LLM DEFAULTS
# =============================================================================

# Default model for general use (set in ~/.hermes/config.yaml)
# Common options: openrouter/free, groq, gemini-2.0, llama-2-70b
LLM_MODEL=openrouter/free

# Temperature (0-1): Lower = more focused, Higher = more creative
LLM_TEMPERATURE=0.7

# Max tokens for generation
LLM_MAX_TOKENS=2048

# =============================================================================
# OPTIONAL: TOOL APIs
# =============================================================================

# Web search / content extraction
EXA_API_KEY=YOUR-KEY-HERE
FIRECRAWL_API_KEY=YOUR-KEY-HERE

# Image generation
FAL_KEY=YOUR-KEY-HERE

# Browser automation (for agent tools)
BROWSERBASE_API_KEY=YOUR-KEY-HERE
BROWSERBASE_PROJECT_ID=YOUR-PROJECT-ID

# =============================================================================
# OPTIONAL: TERMINAL CONFIGURATION
# =============================================================================

TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# HOW TO USE THIS FILE
# =============================================================================
#
# 1. COPY THIS TO .env:
#    cp .env.secrets.template .env
#
# 2. GET API KEYS (choose at least one free provider):
#    - Groq: https://console.groq.com/keys
#    - Gemini: https://aistudio.google.com/app/apikey
#    - NVIDIA NIM: https://build.nvidia.com
#    - OpenRouter: https://openrouter.ai/keys
#
# 3. EDIT .env AND REPLACE PLACEHOLDERS:
#    GROQ_API_KEY=gsk-YOUR-KEY-HERE  →  GROQ_API_KEY=gsk-proj_abc123xyz...
#
# 4. ACTIVATE FREE MODE:
#    source <(bash free-mode/scripts/activate-secret-agent.sh)
#
# 5. TEST IT:
#    hermes "Hello!"  # Will route through free providers
#
# 6. YOU'RE DONE!
#    All hermes/claude commands now use smart routing
#    75-95% cheaper than standard API pricing
#
