# Required for GitHub REST / clone operations.
GITHUB_TOKEN=

# Required for Vercel CLI/API operations.
VERCEL_TOKEN=

# Use one of these when projects live under a Vercel team.
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

# Optional production safety gate.
PRODUCTION_BRANCH=main

# Required for GitHub webhook signature verification in server mode.
GITHUB_WEBHOOK_SECRET=

# Required for A2A task calls in server mode.
A2A_SHARED_SECRET=

# Optional: bypass token for protected Vercel deployments.
VERCEL_BYPASS_TOKEN=

# Optional: default GitHub owner/org for inventory sweeps.
DEFAULT_GITHUB_OWNER=

# Optional: port for the local receiver.
PORT=8787
