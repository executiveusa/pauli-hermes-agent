{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://executiveusa.dev/schemas/hermes-task-request.schema.json",
  "title": "Hermes Complete Subagent Task Packet",
  "type": "object",
  "required": ["schema_version", "mission_id", "mission_objective", "mission_constraints", "task_id", "title", "goal", "context", "dependencies", "acceptance_criteria", "required_evidence", "allowed_inputs", "allowed_outputs", "prohibited_actions", "side_effect_class", "attempt", "idempotency_key", "run_directory", "result_path", "checkpoint_directory", "side_effect_journal_path", "resume_from", "limits", "worker_requirements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "mission_id": {"type": "string"},
    "mission_objective": {"type": "string", "minLength": 10},
    "mission_constraints": {"type": "array", "items": {"type": "string"}},
    "task_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 10},
    "context": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "side_effect_class": {"enum": ["none", "local_reversible", "approval_required", "irreversible"]},
    "attempt": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 8},
    "run_directory": {"type": "string", "minLength": 1},
    "result_path": {"type": "string", "minLength": 1},
    "checkpoint_directory": {"type": "string", "minLength": 1},
    "side_effect_journal_path": {"type": "string", "minLength": 1},
    "resume_from": {"type": ["string", "null"]},
    "limits": {
      "type": "object",
      "required": ["max_iterations", "lease_seconds", "estimated_cost_usd"],
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 100},
        "lease_seconds": {"type": "integer", "minimum": 1},
        "estimated_cost_usd": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "worker_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
