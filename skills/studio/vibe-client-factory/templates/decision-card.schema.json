{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe.engineering/schemas/decision-card.schema.json",
  "title": "Vibe Client Decision Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "question",
    "why_it_matters",
    "options",
    "recommendation",
    "recommendation_reason",
    "evidence_refs",
    "authority_required",
    "authorized_next_action",
    "not_authorized",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "summary", "consequence"],
        "properties": {
          "id": {
            "enum": ["A", "B"]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          },
          "preview_ref": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "recommendation": {
      "enum": ["A", "B"]
    },
    "recommendation_reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_required": {
      "enum": [
        "READ",
        "ANALYZE",
        "DRAFT",
        "REVERSIBLE_INTERNAL",
        "CLIENT_FACING",
        "RELEASE",
        "SENSITIVE"
      ]
    },
    "authorized_next_action": {
      "type": "string",
      "minLength": 1
    },
    "not_authorized": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY_FOR_CLIENT",
        "ANSWERED",
        "SUPERSEDED",
        "CANCELLED"
      ]
    },
    "selected_option": {
      "type": ["string", "null"],
      "enum": ["A", "B", null]
    },
    "decided_by": {
      "type": ["string", "null"]
    },
    "decided_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
