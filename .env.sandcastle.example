# Sandcastle Configuration
SANDCASTLE_ENABLED=true
SANDCASTLE_DEFAULT_PROVIDER=auto
SANDCASTLE_ALLOW_NO_SANDBOX=false
SANDCASTLE_MAX_PARALLEL=3
SANDCASTLE_LOG_LEVEL=info
SANDCASTLE_EVENT_STREAM=true

# Vercel Firecracker microVM provider
VERCEL_SANDBOX_ENABLED=false
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=your_team_id_here

# Docker provider
DOCKER_SANDBOX_ENABLED=true
# Requires: docker daemon running locally

# Podman provider
PODMAN_SANDBOX_ENABLED=false
# Requires: podman binary installed

# Logging
SANDCASTLE_LOG_PERSISTENCE=true
SANDCASTLE_MAX_LOG_SIZE=5000000
