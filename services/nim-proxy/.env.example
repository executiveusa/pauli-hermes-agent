# NVIDIA NIM Free Inference Proxy - Environment Variables
# Copy to .env and fill in your values

# Required: NVIDIA NIM API key (free at build.nvidia.com)
NVIDIA_NIM_API_KEY=nvapi-your-key-here

# Optional: Telegram bot token for bot wrapper mode
TELEGRAM_BOT_TOKEN=

# Optional: Restrict Telegram bot to specific user ID
ALLOWED_TELEGRAM_USER_ID=

# Server config (defaults work fine)
HOST=0.0.0.0
PORT=8082

# Model to route all Claude requests to (free on NIM)
MODEL=moonshotai/kimi-k2-thinking

# Claude CLI → NIM proxy routing
ANTHROPIC_BASE_URL=http://31.220.58.212:8082
ANTHROPIC_API_KEY=dummy
